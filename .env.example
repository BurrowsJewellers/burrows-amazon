PORT=3200
BASE_PATH=/amazon

# Shared with the Laravel sync app - the store mirror lives here and is read-only to us
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=retailedge_shopify
DB_USERNAME=
DB_PASSWORD=

# Copy these from /var/www/retailedge-shopify/.env - they are already set up and working
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_SELLER_ID=
AMAZON_MARKETPLACE_ID=A39IBJ37TRP1C6
AMAZON_ENDPOINT=https://sellingpartnerapi-fe.amazon.com

# The master switch. While false, nothing is ever written to Amazon - the matching
# and reporting still run, so the interface fills up without any risk.
AMAZON_CHANNEL_ENABLED=false

# A product that cannot clear this margin after Amazon's referral fee is not listed.
# Zero means the floor has not been agreed yet.
AMAZON_MIN_MARGIN_PCT=0
